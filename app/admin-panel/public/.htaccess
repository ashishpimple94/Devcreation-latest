# Ensure index.html is the default directory index
DirectoryIndex index.html
Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # If directory has index.html, serve it directly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Dynamic Order Detail route: /orders/<id> -> /orders/detail.html?id=<id>
  RewriteRule ^orders/([a-zA-Z0-9_-]+)/?$ /orders/detail.html?id=$1 [QSA,L]

  # Dynamic Product Edit route: /products/<id> -> /products/edit.html?id=<id>
  RewriteRule ^products/([a-zA-Z0-9_-]+)/?$ /products/edit.html?id=$1 [QSA,L]

  # If requested path with .html exists as a file, serve it
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Fallback all other requests to root index.html (Next.js SPA routing)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
