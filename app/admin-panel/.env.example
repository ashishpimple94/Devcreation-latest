# Public base URL of the Express API (browser-visible).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Base URL of the API for the real-time Socket.IO connection.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# URL of the customer storefront (for the "View store" link).
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
