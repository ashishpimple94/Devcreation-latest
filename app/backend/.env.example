# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# ── CORS (comma-separated: storefront + admin panel) ──
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ── MongoDB ────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/dev_creation

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── JWT ────────────────────────────────────────────────
# Generate strong random values, e.g. `openssl rand -hex 48`
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Uploads / image storage ────────────────────────────
# "local" for dev (served from /uploads). In production use S3/Cloudinary — only URLs are stored in Mongo.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
PUBLIC_ASSET_BASE=http://localhost:4000

# ── Seed admin (created by `npm run seed`) ─────────────
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@devcreation.example
SEED_ADMIN_PASSWORD=Admin@12345

# ── Rate limiting ──────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Email / SMTP ───────────────────────────────────────
# Leave SMTP_HOST empty to run in dev mode (emails are logged to the console,
# not actually sent). For real delivery, fill these in (e.g. Gmail, Mailtrap, SES).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Dev Creation <no-reply@devcreation.example>
# Where "new order" admin alerts are sent. Falls back to SEED_ADMIN_EMAIL if unset.
ADMIN_NOTIFY_EMAIL=
# Public storefront URL used in email links.
STORE_URL=http://localhost:3000

# ── Real SMS Gateway (Fast2SMS / 2Factor / Twilio) ─────
# Leave empty for dev/test mode (OTP is returned in response + logged in console).
# For real SMS delivery to customer mobile phones:
# FAST2SMS_API_KEY=
# TWO_FACTOR_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
ENABLE_SMS_FALLBACK_DEMO=true
