# ============================================================
# Dev Creation — Backend Production Environment (.env)
# ============================================================

# ── Server ─────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_PREFIX=/api

# ── CORS Origins ───────────────────────────────────────
# Comma-separated list of allowed frontend / admin URLs (no trailing slash)
# Replace with your actual deployed storefront and admin panel domains:
CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com,http://localhost:3000,http://localhost:3001

# ── MongoDB Database ──────────────────────────────────
# MongoDB Atlas connection string (or self-hosted MongoDB URI)
MONGODB_URI=mongodb+srv://devcreation:devcreation@cluster0.ezzkjmw.mongodb.net/dev_creation?retryWrites=true&w=majority&appName=Cluster0

# ── Redis Cache & Pub/Sub ──────────────────────────────
# If running with docker compose, use: redis://redis:6379
# If running standalone without Redis, leave as redis://127.0.0.1:6379 (app runs gracefully in degraded mode)
REDIS_URL=redis://127.0.0.1:6379

# ── JWT Secrets ────────────────────────────────────────
# Generate strong 64-char keys via `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace_with_strong_production_access_secret_64chars_minimum
JWT_REFRESH_SECRET=replace_with_strong_production_refresh_secret_64chars_minimum
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Uploads & Media Storage ───────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Base URL for public image serving (your API domain or IP)
PUBLIC_ASSET_BASE=https://api.yourdomain.com

# ── Default Admin Seed ─────────────────────────────────
# Created when running: npm run seed:prod
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@devcreation.example
SEED_ADMIN_PASSWORD=Admin@12345

# ── Rate Limiting ──────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

# ── Email / SMTP (Optional) ───────────────────────────
# If left empty, emails will simply be logged without failing requests
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Dev Creation <no-reply@devcreation.example>
ADMIN_NOTIFY_EMAIL=admin@devcreation.example
STORE_URL=https://yourdomain.com
