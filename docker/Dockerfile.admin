# ============================================================
# Dev Creation — Admin Panel Dockerfile (Next.js 14 Standalone)
# Multi-stage optimized production build
# ============================================================

# ── Stage 1: Builder ──────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Build-time environment variables for Next.js public client bundle
ARG NEXT_PUBLIC_API_URL=/api
ARG NEXT_PUBLIC_SOCKET_URL=/
ARG NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SOCKET_URL=$NEXT_PUBLIC_SOCKET_URL
ENV NEXT_PUBLIC_STOREFRONT_URL=$NEXT_PUBLIC_STOREFRONT_URL
ENV NEXT_TELEMETRY_DISABLED=1

# Install dependencies
COPY app/package*.json ./app/
COPY app/admin-panel/package*.json ./app/admin-panel/

WORKDIR /app/admin-panel
RUN npm install --no-audit

# Copy source and build standalone output
COPY app/admin-panel ./
RUN npm run build

# ── Stage 2: Production Runner ────────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1

# Create unprivileged system user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy standalone server, static assets, and public directory
COPY --from=builder /app/admin-panel/public ./admin-panel/public
COPY --from=builder --chown=nextjs:nodejs /app/admin-panel/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/admin-panel/.next/static ./admin-panel/.next/static

USER nextjs

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3001/ || exit 1

CMD ["node", "admin-panel/server.js"]
