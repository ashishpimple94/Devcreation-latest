# ============================================================
# Dev Creation — EC2 Production Environment Configuration
# Copy this file to .env.production on your EC2 instance:
#   cp .env.production.example .env.production
# ============================================================

# ── General Server Settings ──────────────────────────────────
NODE_ENV=production
PORT=4000
API_PREFIX=/api

# ── Allowed CORS Origins ────────────────────────────────────
# Set to '*' for all, or comma-separated list of your domains / IPs:
# e.g., http://54.x.x.x,http://54.x.x.x:3001,https://yourdomain.com,https://admin.yourdomain.com
CORS_ORIGIN=*

# ── Database Connection ─────────────────────────────────────
# Option A (Recommended): MongoDB Atlas Cloud connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dev_creation?retryWrites=true&w=majority

# Option B: Local Docker MongoDB container (uncomment to use local container)
# MONGODB_URI=mongodb://mongo:27017/dev_creation

# ── In-Memory Cache & Pub/Sub ──────────────────────────────
# Connects to the redis container defined in docker-compose
REDIS_URL=redis://redis:6379

# ── Authentication & JWT Secrets ────────────────────────────
# Generate secure 64-character hex strings:
# openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_64_character_random_hex_secret_key_access
JWT_REFRESH_SECRET=replace_with_64_character_random_hex_secret_key_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Uploads & Media Storage ─────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15
# Base URL for public media links (your EC2 public IP or domain)
# e.g., http://54.210.12.34 or https://yourdomain.com
PUBLIC_ASSET_BASE=http://your-ec2-public-ip

# ── Default Super Admin Credentials ─────────────────────────
# Created when running: docker compose exec backend npm run seed:prod
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@devcreation.com
SEED_ADMIN_PASSWORD=ChangeMeStrongPassword123!

# ── Rate Limiting (Protection against abuse / brute force) ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Email / SMTP (Optional) ─────────────────────────────────
# Leave SMTP_HOST empty to test without email (logs to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Dev Creation <no-reply@devcreation.com>
ADMIN_NOTIFY_EMAIL=admin@devcreation.com
STORE_URL=http://your-ec2-public-ip

# ── Next.js Frontend & Admin Public Build Variables ─────────
# When using Nginx reverse proxy, /api and / are routed on the same domain/IP!
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SOCKET_URL=/
# Admin panel URL:
# For IP testing: http://<EC2-IP>:3001
# For domain: https://admin.yourdomain.com
NEXT_PUBLIC_ADMIN_URL=http://your-ec2-public-ip:3001
NEXT_PUBLIC_STOREFRONT_URL=http://your-ec2-public-ip
